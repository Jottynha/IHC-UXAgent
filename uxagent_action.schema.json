{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UXAgent action proposal",
  "description": "Closed action vocabulary proposed by the LLM. The controller validates preconditions and state transitions before execution. Step order and checklist opening are explicit actions.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "select_role"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "member",
            "role"
          ],
          "properties": {
            "member": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "enum": [
                "LOCATE_RESOURCE",
                "ACTIVATE_CHECKPOINT",
                "TRANSPORT_RESOURCE"
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "set_step_order"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "LOCATE_RESOURCE",
                  "ACTIVATE_CHECKPOINT",
                  "TRANSPORT_RESOURCE"
                ]
              }
            }
          }
        }
      },
      "description": "Choose the execution order of the three mission steps. The controller must reject orders that violate dependencies."
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "send_ping"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "PLAN_UPDATED",
                "NEXT_STEP_ACTIVATE_CHECKPOINT"
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "open_checklist"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      },
      "description": "Open the mission checklist; this is logged separately from contextual help."
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "open_help"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic"
          ],
          "properties": {
            "topic": {
              "type": "string",
              "enum": [
                "mission_requirements",
                "role_constraints",
                "task_dependencies"
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "refresh_feed"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "review_plan"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "confirm_plan"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    }
  ]
}
